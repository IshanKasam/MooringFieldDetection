# Google Maps API Key (required for satellite imagery downloads and Places enrichment)
GOOGLE_MAPS_API_KEY=

# Google Gemini API Key (required if research_provider is set to 'live' in config/enrichment.yaml)
# Create a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Groq API Key (required if research_provider is set to 'groq' in config/enrichment.yaml)
# Create a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Web Application Server Settings
MOORING_WEB_HOST=0.0.0.0
MOORING_WEB_PORT=8000
MOORING_CORS_ALLOW_ALL=true

# Database Path Override (defaults to data/mooring_fields.db; set to /data in container volume mounts)
MOORING_DATA_DIR=data
